# Secrets & environment for postmaker. Copy to .env and fill in.
# Loaded by direnv (see .envrc: `dotenv`) — plain KEY=value, no `export`.
# (Structure — networks, prompts, templates — lives in postmaker.toml, not here.)

# --- required: Discourse REST API ---
DISCOURSE_URL=https://discourse.example.com
DISCOURSE_API_KEY=your-admin-or-user-api-key
DISCOURSE_API_USERNAME=postmaker

# --- optional overrides (defaults come from postmaker.toml) ---
# POSTMAKER_CONFIG=postmaker.toml
# POSTMAKER_TAG=public
# POSTMAKER_CATEGORY_ID=5
# POSTMAKER_POLL_INTERVAL=60
# POSTMAKER_CLAUDE_BIN=claude
# POSTMAKER_CLAUDE_MODEL=claude-opus-4-8
# POSTMAKER_DRY_RUN=1
